<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /jong/shopee_live/

  # Clean URLs: /login/, /dashboard/, /logout/ -> *.php
  RewriteRule ^(dashboard|login|logout)/?$ $1.php [L,QSA]
  RewriteRule ^$ index.php [L]

  RewriteRule ^(data|vendor|\.git) - [F,L]
</IfModule>

<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
